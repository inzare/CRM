generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SALES
  CONSULTANT
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum StageType {
  OPEN
  WON
  LOST
}

enum CatalogType {
  CONSULTING
  SUBSCRIPTION
  LICENSE
  IMPLEMENTATION
}

enum PricingModel {
  ONE_TIME
  RECURRING
  PER_USER
  FIXED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  TASK
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String                    @id @default(uuid()) @db.Uuid
  name                String                    @db.VarChar(160)
  email               String                    @unique @db.VarChar(254)
  passwordHash        String?
  role                Role
  isActive            Boolean                   @default(true)
  lastLoginAt         DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?                 @db.Timestamptz(3)
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  invitationTokens    InvitationToken[]         @relation("InvitationUser")
  invitationsCreated  InvitationToken[]         @relation("InvitationCreator")
  auditEvents         AuditLog[]                @relation("AuditActor")
  ownedCompanies      Company[]                 @relation("CompanyOwner")
  ownedContacts       Contact[]                 @relation("ContactOwner")
  ownedLeads          Lead[]                    @relation("LeadOwner")
  ownedOpportunities  Opportunity[]             @relation("OpportunityOwner")
  opportunityHistory  OpportunityStageHistory[] @relation("StageHistoryActor")
  ownedContracts      Contract[]                @relation("ContractOwner")
  createdActivities   Activity[]                @relation("ActivityCreator")
  assignedTasks       Task[]                    @relation("TaskAssignee")
  createdTasks        Task[]                    @relation("TaskCreator")
  completedTasks      Task[]                    @relation("TaskCompleter")

  @@index([role, isActive])
  @@index([deletedAt])
}

model RefreshSession {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  familyId     String           @db.Uuid
  tokenHash    String           @unique @db.Char(64)
  expiresAt    DateTime         @db.Timestamptz(3)
  revokedAt    DateTime?        @db.Timestamptz(3)
  replacedById String?          @db.Uuid
  ipAddress    String?          @db.VarChar(64)
  userAgent    String?          @db.VarChar(512)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession?  @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces     RefreshSession[] @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model InvitationToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        User      @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  requestId  String   @db.VarChar(128)
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  industry      String?       @db.VarChar(120)
  website       String?       @db.VarChar(500)
  size          String?       @db.VarChar(60)
  addressLine1  String?       @db.VarChar(200)
  addressLine2  String?       @db.VarChar(200)
  city          String?       @db.VarChar(100)
  state         String?       @db.VarChar(100)
  postalCode    String?       @db.VarChar(30)
  country       String?       @db.VarChar(100)
  ownerId       String        @db.Uuid
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?     @db.Timestamptz(3)
  owner         User          @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tags          CompanyTag[]
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]

  @@index([ownerId, deletedAt])
  @@index([name])
  @@index([industry])
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(80)
  color     String?      @db.VarChar(20)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  companies CompanyTag[]
}

model CompanyTag {
  companyId String  @db.Uuid
  tagId     String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([tagId])
}

model Contact {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  ownerId         String        @db.Uuid
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  jobTitle        String?       @db.VarChar(160)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(60)
  isDecisionMaker Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?     @db.Timestamptz(3)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner           User          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  primaryFor      Opportunity[] @relation("PrimaryContact")
  activities      Activity[]
  tasks           Task[]

  @@unique([companyId, email])
  @@index([ownerId, deletedAt])
  @@index([companyId, lastName, firstName])
}

model Lead {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String?      @db.Uuid
  ownerId            String       @db.Uuid
  companyName        String?      @db.VarChar(200)
  contactFirstName   String       @db.VarChar(100)
  contactLastName    String       @db.VarChar(100)
  email              String?      @db.VarChar(254)
  phone              String?      @db.VarChar(60)
  source             String       @db.VarChar(120)
  interest           String
  budget             Decimal?     @db.Decimal(19, 4)
  currency           String       @default("USD") @db.Char(3)
  expectedTimeline   String?      @db.VarChar(120)
  qualificationNotes String?
  status             LeadStatus   @default(NEW)
  qualifiedAt        DateTime?    @db.Timestamptz(3)
  convertedAt        DateTime?    @db.Timestamptz(3)
  opportunityId      String?      @unique @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?    @db.Timestamptz(3)
  company            Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              User         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  opportunity        Opportunity? @relation("ConvertedLead", fields: [opportunityId], references: [id], onDelete: SetNull)
  activities         Activity[]
  tasks              Task[]

  @@index([ownerId, status, deletedAt])
  @@index([email])
}

model PipelineStage {
  id                 String                    @id @default(uuid()) @db.Uuid
  key                String                    @unique @db.VarChar(60)
  displayName        String                    @db.VarChar(100)
  order              Int                       @unique
  type               StageType                 @default(OPEN)
  defaultProbability Int
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  opportunities      Opportunity[]
  historyFrom        OpportunityStageHistory[] @relation("HistoryFromStage")
  historyTo          OpportunityStageHistory[] @relation("HistoryToStage")
  transitionsFrom    PipelineTransition[]      @relation("TransitionFrom")
  transitionsTo      PipelineTransition[]      @relation("TransitionTo")
}

model PipelineTransition {
  fromStageId String        @db.Uuid
  toStageId   String        @db.Uuid
  fromStage   PipelineStage @relation("TransitionFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage     PipelineStage @relation("TransitionTo", fields: [toStageId], references: [id], onDelete: Cascade)

  @@id([fromStageId, toStageId])
  @@index([toStageId])
}

model Opportunity {
  id               String                    @id @default(uuid()) @db.Uuid
  name             String                    @db.VarChar(200)
  companyId        String                    @db.Uuid
  primaryContactId String?                   @db.Uuid
  ownerId          String                    @db.Uuid
  stageId          String                    @db.Uuid
  expectedValue    Decimal                   @db.Decimal(19, 4)
  currency         String                    @default("USD") @db.Char(3)
  probability      Int
  closeDate        DateTime                  @db.Date
  actualCloseDate  DateTime?                 @db.Date
  competitor       String?                   @db.VarChar(200)
  lossReason       String?                   @db.VarChar(500)
  notes            String?
  sourceLeadId     String?                   @unique @db.Uuid
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?                 @db.Timestamptz(3)
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact   Contact?                  @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  owner            User                      @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stage            PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sourceLead       Lead?                     @relation("ConvertedLead")
  stageHistory     OpportunityStageHistory[]
  items            OpportunityItem[]
  quotes           Quote[]
  contracts        Contract[]
  activities       Activity[]
  tasks            Task[]

  @@index([ownerId, stageId, deletedAt])
  @@index([companyId, deletedAt])
  @@index([closeDate])
}

model OpportunityStageHistory {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @db.Uuid
  fromStageId   String?        @db.Uuid
  toStageId     String         @db.Uuid
  actorId       String         @db.Uuid
  reason        String?        @db.VarChar(500)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage       PipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  actor         User           @relation("StageHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([toStageId, createdAt])
}

model CatalogItem {
  id               String            @id @default(uuid()) @db.Uuid
  sku              String            @unique @db.VarChar(80)
  name             String            @db.VarChar(200)
  category         String            @db.VarChar(120)
  type             CatalogType
  pricingModel     PricingModel
  price            Decimal           @db.Decimal(19, 4)
  currency         String            @default("USD") @db.Char(3)
  isActive         Boolean           @default(true)
  description      String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  opportunityItems OpportunityItem[]

  @@index([category, isActive])
  @@index([type, isActive])
}

model OpportunityItem {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @db.Uuid
  catalogItemId String      @db.Uuid
  quantity      Decimal     @db.Decimal(12, 4)
  unitPrice     Decimal     @db.Decimal(19, 4)
  currency      String      @default("USD") @db.Char(3)
  billingNotes  String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, catalogItemId])
  @@index([opportunityId, sortOrder])
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @db.Uuid
  number        String      @unique @db.VarChar(80)
  version       Int
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("USD") @db.Char(3)
  subtotal      Decimal     @db.Decimal(19, 4)
  discountTotal Decimal     @default(0) @db.Decimal(19, 4)
  taxTotal      Decimal     @default(0) @db.Decimal(19, 4)
  total         Decimal     @db.Decimal(19, 4)
  validUntil    DateTime    @db.Date
  notes         String?
  sentAt        DateTime?   @db.Timestamptz(3)
  acceptedAt    DateTime?   @db.Timestamptz(3)
  rejectedAt    DateTime?   @db.Timestamptz(3)
  expiredAt     DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  lines         QuoteLine[]
  contracts     Contract[]

  @@unique([opportunityId, version])
  @@index([opportunityId, status])
  @@index([validUntil, status])
}

model QuoteLine {
  id            String  @id @default(uuid()) @db.Uuid
  quoteId       String  @db.Uuid
  catalogItemId String? @db.Uuid
  sku           String  @db.VarChar(80)
  description   String
  quantity      Decimal @db.Decimal(12, 4)
  unitPrice     Decimal @db.Decimal(19, 4)
  discountRate  Decimal @default(0) @db.Decimal(7, 4)
  taxRate       Decimal @default(0) @db.Decimal(7, 4)
  subtotal      Decimal @db.Decimal(19, 4)
  discount      Decimal @default(0) @db.Decimal(19, 4)
  tax           Decimal @default(0) @db.Decimal(19, 4)
  total         Decimal @db.Decimal(19, 4)
  sortOrder     Int     @default(0)
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@index([catalogItemId])
}

model Contract {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @db.Uuid
  quoteId       String         @db.Uuid
  ownerId       String         @db.Uuid
  number        String         @unique @db.VarChar(80)
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date
  renewalDate   DateTime?      @db.Date
  amount        Decimal        @db.Decimal(19, 4)
  currency      String         @default("USD") @db.Char(3)
  status        ContractStatus @default(DRAFT)
  renewalNotes  String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?      @db.Timestamptz(3)
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  owner         User           @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, renewalDate])
  @@index([opportunityId])
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  type          ActivityType
  subject       String       @db.VarChar(240)
  body          String?
  occurredAt    DateTime?    @db.Timestamptz(3)
  companyId     String?      @db.Uuid
  contactId     String?      @db.Uuid
  leadId        String?      @db.Uuid
  opportunityId String?      @db.Uuid
  creatorId     String       @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?    @db.Timestamptz(3)
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  creator       User         @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  task          Task?

  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([creatorId, createdAt])
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  activityId    String?      @unique @db.Uuid
  subject       String       @db.VarChar(240)
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(OPEN)
  dueAt         DateTime     @db.Timestamptz(3)
  companyId     String?      @db.Uuid
  contactId     String?      @db.Uuid
  leadId        String?      @db.Uuid
  opportunityId String?      @db.Uuid
  assigneeId    String       @db.Uuid
  creatorId     String       @db.Uuid
  completedById String?      @db.Uuid
  completedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?    @db.Timestamptz(3)
  activity      Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator       User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  completedBy   User?        @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
}
