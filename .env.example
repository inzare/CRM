NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://consultflow:consultflow_local@localhost:5432/consultflow?schema=public
TEST_DATABASE_URL=postgresql://consultflow:consultflow_test@localhost:5433/consultflow_test?schema=public
JWT_ACCESS_SECRET=development-only-access-secret-change-before-production
